{
  "name": "antigravity-swap",
  "displayName": "Antigravity Swap",
  "description": "Seamless multi-account switcher and real-time model quota tracker for Antigravity IDE without reload.",
  "version": "1.0.0",
  "publisher": "phuctmplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/phuctmplate/antigravity_swap"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:antigravitySwap.dashboardView"
  ],
  "enabledApiProposals": [
    "antigravityUnifiedStateSync"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "antigravity-swap-sidebar",
          "title": "Antigravity Swap",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "antigravity-swap-sidebar": [
        {
          "type": "webview",
          "id": "antigravitySwap.dashboardView",
          "name": "Account & Quota Dashboard",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "antigravitySwap.switchAccount",
        "title": "Switch Active Account",
        "category": "Antigravity Swap",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "antigravitySwap.addAccount",
        "title": "Add Account (Google OAuth)",
        "category": "Antigravity Swap",
        "icon": "$(account)"
      },
      {
        "command": "antigravitySwap.addAccountManual",
        "title": "Add Account (Paste Refresh/Access Token)",
        "category": "Antigravity Swap",
        "icon": "$(key)"
      },
      {
        "command": "antigravitySwap.refreshQuotas",
        "title": "Refresh All Account Quotas",
        "category": "Antigravity Swap",
        "icon": "$(refresh)"
      },
      {
        "command": "antigravitySwap.openDashboard",
        "title": "Open Quota & Account Dashboard",
        "category": "Antigravity Swap",
        "icon": "$(dashboard)"
      },
      {
        "command": "antigravitySwap.importExistingAccounts",
        "title": "Import Detected Accounts",
        "category": "Antigravity Swap",
        "icon": "$(cloud-download)"
      },
      {
        "command": "antigravitySwap.reloginAccount",
        "title": "Re-login / Reconnect Account",
        "category": "Antigravity Swap",
        "icon": "$(key)"
      },
      {
        "command": "antigravitySwap.importCurrentAntigravity",
        "title": "Import Active Antigravity Account",
        "category": "Antigravity Swap",
        "icon": "$(zap)"
      },
      {
        "command": "antigravitySwap.popOutDashboard",
        "title": "Pop Out Dashboard (Detach Window)",
        "category": "Antigravity Swap",
        "icon": "$(link-external)"
      },
      {
        "command": "antigravitySwap.restoreOriginalIdeExtension",
        "title": "Restore Original Antigravity IDE Extension (Revert Patch)",
        "category": "Antigravity Swap",
        "icon": "$(history)"
      },
      {
        "command": "antigravitySwap.enableIdeExtensionPatch",
        "title": "Enable Antigravity IDE Extension Patch (Zero-Reload Mode)",
        "category": "Antigravity Swap",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "antigravitySwap.popOutDashboard",
          "when": "view == antigravitySwap.dashboardView",
          "group": "navigation@1"
        },
        {
          "command": "antigravitySwap.refreshQuotas",
          "when": "view == antigravitySwap.dashboardView",
          "group": "navigation@2"
        },
        {
          "command": "antigravitySwap.addAccount",
          "when": "view == antigravitySwap.dashboardView",
          "group": "navigation@3"
        },
        {
          "command": "antigravitySwap.switchAccount",
          "when": "view == antigravitySwap.dashboardView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Antigravity Swap",
      "properties": {
        "antigravitySwap.enableIdeExtensionPatch": {
          "type": "boolean",
          "default": true,
          "description": "Enable self-healing patch for Antigravity IDE built-in extension to allow instant zero-reload account switching and clean session eviction."
        },
        "antigravitySwap.heartbeatIntervalSeconds": {
          "type": "number",
          "default": 30,
          "description": "Heartbeat interval in seconds to poll quota health and detect expired/banned accounts."
        },
        "antigravitySwap.autoSwitchWhenQuotaLow": {
          "type": "boolean",
          "default": false,
          "description": "Automatically switch to another account with healthy quota when current active account reaches low quota."
        },
        "antigravitySwap.lowQuotaThresholdPercent": {
          "type": "number",
          "default": 3,
          "description": "Percentage threshold (default 3%) below which the active account triggers auto-switching to another healthy account."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:webview": "vite build",
    "build:extension": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18",
    "build": "npm run build:webview && npm run build:extension",
    "package": "vsce package"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.14.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/vsce": "^2.30.0",
    "esbuild": "^0.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.2",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
